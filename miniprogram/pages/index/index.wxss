/* ========== 品牌 Header ========== */
.brand-header {
  background: linear-gradient(165deg, #F8F1E3 0%, #FFF8EA 35%, #F5E6D0 70%, #EDD9C0 100%);
  padding: 40rpx 32rpx 24rpx;
  text-align: center;
}
.brand-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.logo-circle {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: var(--color-red);
  display: flex;
  align-items: center;
  justify-content: center;
}
.logo-inner {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background-color: var(--color-gold);
}
.brand-name {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--color-dark);
}
.brand-slogan {
  font-size: 26rpx;
  color: var(--color-brown);
  letter-spacing: 4rpx;
}

/* ========== Banner ========== */
.banner {
  width: 100%;
  height: 340rpx;
}
.banner-slide {
  position: relative;
  width: 100%;
  height: 100%;
}
.banner-image {
  width: 100%;
  height: 100%;
}
.banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 60rpx 32rpx 24rpx;
  background: linear-gradient(transparent, rgba(46, 36, 28, 0.65));
}
.banner-title {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
  color: #FFFFFF;
  margin-bottom: 4rpx;
}
.banner-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ========== 快速入口 ========== */
.quick-entry {
  display: flex;
  justify-content: space-around;
  padding: 32rpx 16rpx;
  background-color: #FFFFFF;
  margin: -24rpx 24rpx 0;
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
  position: relative;
  z-index: 1;
}
.quick-entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.quick-entry-icon {
  font-size: 44rpx;
}
.quick-entry-text {
  font-size: 22rpx;
  color: var(--color-dark);
  font-weight: 500;
}

/* ========== 通用 Section ========== */
.section {
  padding: 32rpx 24rpx;
  background-color: var(--color-cream);
}
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.section-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.section-icon {
  font-size: 40rpx;
}
.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-dark);
}
.section-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}
.section-more {
  font-size: 26rpx;
  color: var(--color-red);
  font-weight: 600;
}

/* ========== 商品横向滚动 ========== */
.product-scroll {
  white-space: nowrap;
}
.product-scroll-inner {
  display: flex;
  gap: 16rpx;
  padding-bottom: 8rpx;
}
.product-card {
  display: inline-block;
  width: 280rpx;
  white-space: normal;
  flex-shrink: 0;
}
.product-image {
  width: 100%;
  height: 220rpx;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}
.product-info {
  padding: 16rpx 20rpx 20rpx;
}
.product-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-dark);
  margin-bottom: 8rpx;
}
.product-tags {
  margin-bottom: 12rpx;
}
.product-price-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}
.product-unit {
  font-size: 22rpx;
  color: #999999;
}

/* ========== 礼盒横向滚动 ========== */
.gift-scroll {
  white-space: nowrap;
}
.gift-scroll-inner {
  display: flex;
  gap: 20rpx;
}
.gift-card {
  display: inline-block;
  width: 320rpx;
  flex-shrink: 0;
  position: relative;
  white-space: normal;
}
.gift-hot {
  border: 3rpx solid var(--color-gold);
  transform: scale(1.02);
}
.gift-image {
  width: 100%;
  height: 200rpx;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}
.gift-info {
  padding: 20rpx 24rpx 24rpx;
}
.gift-name {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--color-dark);
}
.gift-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin: 4rpx 0 12rpx;
}
.gift-tags {
  min-height: 40rpx;
  margin-bottom: 10rpx;
}
.gift-price-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-bottom: 6rpx;
}
.gift-sales {
  display: block;
  font-size: 22rpx;
  color: #999999;
}

/* ========== 溯源旅程 ========== */
.journey-section {
  padding: 32rpx 24rpx;
  background: linear-gradient(135deg, #FFFEF9, #FFF8EA);
}
.journey-steps {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
}
.journey-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.step-dot {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}
.step-label {
  font-size: 20rpx;
  color: var(--color-brown);
  text-align: center;
}
.step-arrow {
  font-size: 28rpx;
  color: #CCBBAA;
  margin: 0 4rpx;
  padding-bottom: 20rpx;
}

/* ========== 适合人群 ========== */
.persona-section {
  padding: 32rpx 24rpx;
  background-color: #FFFFFF;
}
.persona-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.persona-card {
  padding: 28rpx 24rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  background-color: var(--color-cream);
  border-radius: var(--radius-xl);
}
.persona-icon {
  font-size: 48rpx;
  margin-bottom: 4rpx;
}
.persona-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-dark);
}
.persona-desc {
  font-size: 22rpx;
  color: #999999;
  line-height: 1.5;
}
.persona-rec {
  font-size: 22rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

/* ========== 底部品牌承诺 ========== */
.brand-footer {
  padding: 48rpx 32rpx 32rpx;
  text-align: center;
  background-color: var(--color-dark);
}
.footer-tagline {
  margin-bottom: 24rpx;
}
.footer-brand-name {
  display: block;
  font-size: 40rpx;
  color: var(--color-gold);
  margin-bottom: 8rpx;
}
.footer-slogan {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
}
.footer-promises {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx 24rpx;
}
.footer-promise {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
}
