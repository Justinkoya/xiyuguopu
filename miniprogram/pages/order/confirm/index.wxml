<!-- 确认订单 -->
<view class="page">
  <!-- 收货地址 -->
  <view class="address-section" bindtap="onChooseAddress">
    <view wx:if="{{address}}">
      <view class="address-info">
        <text class="address-name">{{address.name}}</text>
        <text class="address-phone">{{address.phone}}</text>
      </view>
      <text class="address-detail">{{address.province}} {{address.city}} {{address.district}} {{address.detail}}</text>
    </view>
    <view wx:else class="no-address">
      <text class="no-address-icon">📍</text>
      <text>请选择收货地址</text>
      <text class="no-address-arrow">›</text>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="order-items">
    <view class="order-item" wx:for="{{items}}" wx:key="productId">
      <image src="{{item.image}}" class="order-item-img" mode="aspectFill" />
      <view class="order-item-info">
        <text class="order-item-name">{{item.name}}</text>
        <text class="order-item-unit">/{{item.unit}}</text>
      </view>
      <view class="order-item-right">
        <text class="price">¥{{item.price}}</text>
        <text class="order-item-qty">×{{item.quantity}}</text>
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="remark-section">
    <text class="remark-label">备注</text>
    <input class="remark-input" placeholder="可以注明偏好，比如「不要开心果」" value="{{remark}}" bindinput="onRemarkInput" />
  </view>

  <!-- 价格汇总 -->
  <view class="price-summary">
    <view class="summary-row">
      <text>商品小计</text>
      <text>¥{{subtotal}}</text>
    </view>
    <view class="summary-row">
      <text>运费</text>
      <text class="text-green">{{shipping === 0 ? '全场包邮' : '¥' + shipping}}</text>
    </view>
    <view class="summary-row total">
      <text>合计</text>
      <text class="price">¥<text class="price-large">{{total}}</text></text>
    </view>
  </view>

  <view style="height: 140rpx;"></view>

  <!-- 提交按钮 -->
  <view class="fixed-bottom safe-bottom submit-bar">
    <view class="submit-total">
      <text>合计：</text>
      <text class="price">¥<text class="price-large">{{total}}</text></text>
    </view>
    <button class="btn-primary submit-btn" bindtap="onSubmit">提交订单</button>
  </view>
</view>
