/* ========== 状态栏 ========== */
.status-bar {
  text-align: center;
  padding: 48rpx 32rpx;
  background-color: #FFFFFF;
  margin-bottom: 16rpx;
}
.status-icon {
  display: block;
  font-size: 72rpx;
  margin-bottom: 16rpx;
}
.status-text {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}
.status-desc {
  display: block;
  font-size: 26rpx;
  color: #999999;
}

/* ========== 详情区 ========== */
.detail-section {
  background-color: #FFFFFF;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
}
.detail-section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-dark);
  margin-bottom: 16rpx;
}
.detail-text {
  display: block;
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 4rpx;
}
.detail-address {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.detail-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F8F8F8;
}
.detail-item-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}
.detail-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  font-size: 26rpx;
}
.detail-item-meta {
  color: #999999;
  font-size: 24rpx;
}

.detail-info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
}
.detail-info-label {
  color: #999999;
}
.detail-info-value {
  color: #333333;
  text-align: right;
}
.detail-info-row.total {
  font-size: 32rpx;
  font-weight: 700;
  border-top: 1rpx solid #F0F0F0;
  margin-top: 8rpx;
  padding-top: 20rpx;
}

.loading {
  text-align: center;
  padding: 200rpx 0;
  color: #999999;
}
