/* ========== Tab ========== */
.tab-bar {
  display: flex;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #EEEEEE;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #666666;
  position: relative;
}
.tab-item.active {
  color: var(--color-red);
  font-weight: 700;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background-color: var(--color-red);
  border-radius: 2rpx;
}

/* ========== 订单卡片 ========== */
.order-list {
  padding: 16rpx 24rpx;
}
.order-card {
  background-color: #FFFFFF;
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.order-header {
  display: flex;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F5F5F5;
}
.order-no {
  font-size: 24rpx;
  color: #999999;
}
.order-status {
  font-size: 26rpx;
  font-weight: 700;
}
.order-items {
  padding: 16rpx 0;
}
.order-item-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
}
.order-item-thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}
.order-item-name {
  flex: 1;
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order-item-price {
  font-size: 24rpx;
  color: #999999;
  flex-shrink: 0;
}
.order-footer {
  display: flex;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #F5F5F5;
  font-size: 24rpx;
  color: #999999;
}
.order-total {
  font-size: 26rpx;
  color: var(--color-dark);
}
.order-time {
  display: flex;
  justify-content: space-between;
  padding-top: 12rpx;
  font-size: 22rpx;
  color: #B0B0B0;
}
.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 16rpx;
}
.action-btn {
  font-size: 24rpx;
  padding: 12rpx 28rpx;
  border-radius: var(--radius-full);
}

.loading {
  text-align: center;
  padding: 200rpx 0;
  color: #999999;
}
