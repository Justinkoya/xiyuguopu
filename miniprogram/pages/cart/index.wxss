/* ========== 全选栏 ========== */
.select-all-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #F5F5F5;
}
.select-all-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
}
.select-all-right {
  font-size: 26rpx;
  color: #999999;
}

/* ========== 复选框 ========== */
.checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #DDDDDD;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: transparent;
  flex-shrink: 0;
  transition: all 0.2s;
}
.checkbox.checked {
  background-color: var(--color-red);
  border-color: var(--color-red);
  color: #FFFFFF;
}

/* ========== 商品列表 ========== */
.cart-list {
  background-color: #FFFFFF;
}
.cart-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F8F8F8;
}
.cart-item-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
}
.cart-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.cart-item-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-dark);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cart-item-unit {
  font-size: 22rpx;
  color: #AAAAAA;
}
.cart-item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}
.cart-item-delete {
  font-size: 36rpx;
  padding: 8rpx;
  flex-shrink: 0;
}

/* ========== 数量步进器 ========== */
.quantity-stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid #EEEEEE;
  border-radius: var(--radius-full);
  overflow: hidden;
}
.stepper-btn {
  width: 56rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666666;
  background-color: #F8F8F8;
}
.stepper-value {
  width: 72rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
}

/* ========== 底部结算栏 ========== */
.checkout-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #F0F0F0;
}
.checkout-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  flex-shrink: 0;
}
.checkout-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
}
.checkout-total {
  display: flex;
  align-items: baseline;
  font-size: 26rpx;
  color: #666666;
}
.checkout-btn {
  width: 200rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
}
.checkout-btn[disabled] {
  background-color: #CCCCCC;
  color: #FFFFFF;
}
