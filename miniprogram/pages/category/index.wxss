/* ========== 排序栏 ========== */
.sort-bar {
  display: flex;
  background-color: #FFFFFF;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #EEEEEE;
  position: sticky;
  top: 0;
  z-index: 10;
}
.sort-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #666666;
  position: relative;
}
.sort-item.active {
  color: var(--color-red);
  font-weight: 700;
}
.sort-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: var(--color-red);
  border-radius: 2rpx;
}

/* ========== 分类布局 ========== */
.category-layout {
  display: flex;
  height: calc(100vh - 100rpx);
}
.category-sidebar {
  width: 180rpx;
  background-color: #F8F8F8;
}
.sidebar-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 32rpx 24rpx;
  font-size: 26rpx;
  color: #666666;
}
.sidebar-item.active {
  background-color: #FFFFFF;
  color: var(--color-dark);
  font-weight: 700;
}
.sidebar-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.category-content {
  flex: 1;
  padding: 16rpx;
}

.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.product-item {
  position: relative;
  overflow: hidden;
}
.product-img {
  width: 100%;
  height: 240rpx;
}
.product-body {
  padding: 16rpx 20rpx 20rpx;
}
.product-body .product-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.product-body .product-tags {
  margin-bottom: 10rpx;
  min-height: 36rpx;
}
.product-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.origin-tag {
  font-size: 22rpx;
  color: var(--color-sand);
}
.score-tag {
  font-size: 22rpx;
  color: var(--color-gold);
  font-weight: 600;
}
.product-price-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-bottom: 6rpx;
}
.price-num {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--color-red);
}
.unit {
  font-size: 22rpx;
  color: #999999;
}
.sales-text {
  display: block;
  font-size: 22rpx;
  color: #999999;
}
