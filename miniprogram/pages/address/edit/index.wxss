.form {
  background-color: #FFFFFF;
  margin: 16rpx 0;
}
.form-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}
.form-label {
  width: 140rpx;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
}
.form-value {
  flex: 1;
  font-size: 28rpx;
  color: #999999;
}
.form-picker-inner {
  display: flex;
  align-items: center;
  flex: 1;
}
.form-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
}
.save-wrap {
  padding: 32rpx 24rpx;
}
.save-btn {
  width: 100%;
}
