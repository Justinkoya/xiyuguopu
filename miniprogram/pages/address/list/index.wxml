<!-- 地址列表 -->
<view class="page">
  <view class="address-list" wx:if="{{addresses.length > 0}}">
    <view
      class="address-card {{item.isDefault ? 'default' : ''}}"
      wx:for="{{addresses}}"
      wx:key="_id"
      data-index="{{index}}"
      data-id="{{item._id}}"
      bindtap="{{selectMode ? 'onSelect' : 'onEdit'}}"
    >
      <view class="addr-header">
        <text class="addr-name">{{item.name}}</text>
        <text class="addr-phone">{{item.phone}}</text>
        <view class="addr-default-tag" wx:if="{{item.isDefault}}">默认</view>
      </view>
      <text class="addr-detail">{{item.province}} {{item.city}} {{item.district}} {{item.detail}}</text>
      <view class="addr-actions" wx:if="{{!selectMode}}">
        <text class="addr-action" data-id="{{item._id}}" catchtap="onSetDefault" wx:if="{{!item.isDefault}}">设为默认</text>
        <text class="addr-action" data-id="{{item._id}}" catchtap="onEdit">编辑</text>
        <text class="addr-action delete" data-id="{{item._id}}" catchtap="onDelete">删除</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{addresses.length === 0}}">
    <text class="icon">📍</text>
    <text class="text">暂无收货地址</text>
  </view>

  <view class="add-btn-wrap">
    <button class="btn-primary add-btn" bindtap="onAdd">+ 新增收货地址</button>
  </view>
</view>
