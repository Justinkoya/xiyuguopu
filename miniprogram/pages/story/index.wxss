/* ========== Tab ========== */
.tab-bar {
  display: flex;
  background-color: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666666;
}
.tab-item.active {
  color: var(--color-red);
  font-weight: 700;
  border-bottom: 4rpx solid var(--color-red);
}

/* ========== 品牌故事 ========== */
.hero-bg {
  background: linear-gradient(165deg, #F8F1E3, #FFF8EA, #F5E6D0);
  padding: 80rpx 32rpx;
  text-align: center;
}
.brand-title {
  display: block;
  font-size: 52rpx;
  font-weight: 900;
  color: var(--color-dark);
  margin-bottom: 12rpx;
}
.brand-slogan {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-red);
  margin-bottom: 8rpx;
}
.brand-subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--color-brown);
}

.section-block {
  padding: 40rpx 32rpx;
}
.section-num {
  display: block;
  font-size: 24rpx;
  color: var(--color-red);
  font-weight: 700;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}
.section-heading {
  display: block;
  font-size: 38rpx;
  font-weight: 900;
  color: var(--color-dark);
  margin-bottom: 8rpx;
}
.section-subtitle {
  display: block;
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 24rpx;
}
.section-body {
  font-size: 28rpx;
  color: #555555;
  line-height: 1.9;
}

/* 支柱 */
.pillar {
  margin-top: 24rpx;
  padding: 24rpx;
  background-color: var(--color-cream);
  border-radius: var(--radius-lg);
}
.pillar-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.pillar-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
}

/* 价值观网格 */
.values-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}
.value-card {
  background-color: var(--color-cream);
  border-radius: var(--radius-lg);
  padding: 28rpx 24rpx;
  text-align: center;
}
.value-icon {
  display: block;
  font-size: 48rpx;
  margin-bottom: 8rpx;
}
.value-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}
.value-desc {
  font-size: 22rpx;
  color: #999999;
  line-height: 1.5;
}

/* ========== 6星标准 ========== */
.standard-list {
  padding: 0 32rpx 40rpx;
}
.standard-item {
  padding: 28rpx;
  background-color: var(--color-cream);
  border-radius: var(--radius-lg);
  margin-bottom: 16rpx;
}
.std-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.std-name {
  font-size: 30rpx;
  font-weight: 700;
}
.std-stars {
  font-size: 28rpx;
}
.std-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

/* ========== 产地溯源 ========== */
.origin-hero {
  padding: 60rpx 32rpx 32rpx;
  text-align: center;
  background: linear-gradient(rgba(46,36,28,0.7), rgba(46,36,28,0.7));
  color: #FFFFFF;
}
.origin-hero .section-heading { color: #FFFFFF; }
.origin-hero .section-subtitle { color: rgba(255,255,255,0.7); }
.origin-stats {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 16rpx;
  padding: 32rpx;
  background-color: var(--color-dark);
}
.origin-stat {
  text-align: center;
  padding: 20rpx 0;
}
.stat-num {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
  color: var(--color-gold);
  margin-bottom: 4rpx;
}
.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}
